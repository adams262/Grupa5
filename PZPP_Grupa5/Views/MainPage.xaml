<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PZPP_Grupa5.Views.MainPage"
             xmlns:viewmodels="clr-namespace:PZPP_Grupa5.ViewModels"
             x:DataType="viewmodels:MainViewModel"
             BackgroundColor="{StaticResource Gray950}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0D0D0D" Offset="0.1" />
            <GradientStop Color="#1A0B2E" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>


    <Grid>
        <ScrollView IsVisible="{Binding IsInputVisible}">

            <VerticalStackLayout Padding="25" Spacing="25" HorizontalOptions="Fill" MaximumWidthRequest="500">
                <Label Text="AI analiza wideo"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="DarkViolet"
                       HorizontalOptions="Center"
                       Margin="0,30,0,10"/>

                <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{StaticResource Gray900}" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Klucz API Gemini:" 
                               TextColor="DarkViolet" 
                               FontSize="20" 
                               FontAttributes="Bold"/>
                        <Entry Placeholder="Wklej swój klucz api AI studio..."
                               Text="{Binding UserApiKey}"
                               TextColor="White"
                               PlaceholderColor="{StaticResource Gray600}" />
                        <Label Text="Klucz jest zapisywany lokalnie w urządzeniu."
                               FontSize="10" 
                               TextColor="Gray" 
                               HorizontalOptions="End"/>
                    </VerticalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{StaticResource Gray900}" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Link do filmu z Youtube:" 
                               TextColor="DarkViolet" 
                               FontSize="20"/>
                        <Entry Placeholder="https://www.youtube.com/..."
                               Text="{Binding VideoUrl}"
                               TextColor="White"
                               PlaceholderColor="{StaticResource Gray600}"
                               ClearButtonVisibility="WhileEditing" />
                    </VerticalStackLayout>
                </Border>


                <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{StaticResource Gray900}" Padding="20">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="Opcje analizy:" 
                               TextColor="DarkViolet" 
                               FontSize="20" 
                               FontAttributes="Bold" 
                               Margin="0,0,0,5"/>
                        <HorizontalStackLayout Spacing="15">
                            <CheckBox IsChecked="{Binding ChceStreszczenie}" Color="DarkViolet" />
                            <Label Text="Skrócony opis" 
                                   VerticalOptions="Center" 
                                   TextColor="White" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="15">
                            <CheckBox IsChecked="{Binding ChceWniosek}" Color="DarkViolet" />
                            <Label Text="Kluczowe wnioski" 
                                   VerticalOptions="Center" 
                                   TextColor="White" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="15">
                            <CheckBox IsChecked="{Binding ChceTimestamps}" Color="DarkViolet" />
                            <Label Text="Ważne punkty (Timestamps)" 
                                   VerticalOptions="Center" 
                                   TextColor="White" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Przetwarzaj wideo" 
                        Command="{Binding ProcessVideoCommand}"
                        BackgroundColor="DarkViolet"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="60"
                        WidthRequest="200"
                        HorizontalOptions="Center"/>
            </VerticalStackLayout>
            
        </ScrollView>

        <VerticalStackLayout IsVisible="{Binding IsLoading}" VerticalOptions="Center" HorizontalOptions="Fill" Spacing="30" MaximumWidthRequest="500">
            <ActivityIndicator IsRunning="{Binding IsLoading}" Color="DarkViolet" HeightRequest="120" WidthRequest="120"></ActivityIndicator>
            <Label Text="Trwa analiza materiału..." 
                   TextColor="White" 
                   FontSize="22" 
                   HorizontalOptions="Center" 
                   FontAttributes="Bold">
            </Label>
            <Label Text="Gemini przetwarza dane, proszę czekać." 
                   TextColor="Gray" 
                   HorizontalOptions="Center">
            </Label>
        </VerticalStackLayout>

        <ScrollView IsVisible="{Binding IsResultVisible}">
            <VerticalStackLayout Padding="25" Spacing="20" HorizontalOptions="Fill" MaximumWidthRequest="500">
                <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{StaticResource Gray900}" BackgroundColor="{StaticResource Gray900}">
                    <VerticalStackLayout>
                        <Grid BackgroundColor="{StaticResource Gray950}" Padding="10,5">
                            <Label Text="Wynik analizy:" 
                                   TextColor="DarkViolet" 
                                   FontSize="20" 
                                   VerticalOptions="Center" 
                                   Margin="5" 
                                   FontAttributes="Bold"/>
                            <HorizontalStackLayout HorizontalOptions="End" VerticalOptions="Center" Spacing="5">
                                <ImageButton Command="{Binding SaveToFileCommand}"
                                             HeightRequest="32"
                                             WidthRequest="32"
                                             Padding="6"
                                             CornerRadius="6"
                                             BackgroundColor="Transparent"
                                             Opacity="0.7">
                                    <ImageButton.Source>
                                        <FontImageSource Glyph="&#xf019;" 
                                                         FontFamily="FontAwesomeSolid" 
                                                         Color="DarkViolet" 
                                                         Size="18"/>
                                    </ImageButton.Source>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroupList>
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="Normal">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Property="Opacity" Value="1" />
                                                        <Setter Property="BackgroundColor" Value="#20FFFFFF" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateGroupList>
                                    </VisualStateManager.VisualStateGroups>
                                </ImageButton>

                                <ImageButton Command="{Binding CopyToClipboardCommand}"
                                             HeightRequest="32"
                                             WidthRequest="32"
                                             Padding="6"
                                             CornerRadius="6"
                                             BackgroundColor="Transparent"
                                             Opacity="0.7">
                                <ImageButton.Source>
                                    <FontImageSource Glyph="&#xf0c5;" 
                                                     FontFamily="FontAwesomeSolid" 
                                                     Color="DarkViolet" 
                                                     Size="18"/>
                                </ImageButton.Source>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Setter Property="BackgroundColor" Value="#20FFFFFF" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                            </ImageButton>
                            </HorizontalStackLayout>
                        </Grid>
                        <ScrollView HeightRequest="350" Padding="15">
                            <Label Text="{Binding TekstWynikowy}"
                                   TextColor="{StaticResource Gray200}"
                                   LineHeight="1.4"
                                   FontSize="15"
                                   HorizontalOptions="Fill">
                            </Label>
                        </ScrollView>

                    </VerticalStackLayout>
                </Border>
                <Button Text="Wróć do konfiguracji" 
                        Command="{Binding BackToInputCommand}" 
                        BackgroundColor="DarkViolet" 
                        TextColor="White" 
                        CornerRadius="12" 
                        HeightRequest="50" 
                        Margin="0,20">
                </Button>

            </VerticalStackLayout>
            
        </ScrollView>
        
    </Grid>

</ContentPage>
