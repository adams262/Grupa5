<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PZPP_Grupa5.Views.MainPage"
             xmlns:viewmodels="clr-namespace:PZPP_Grupa5.ViewModels"
             x:DataType="viewmodels:MainViewModel"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{AppThemeBinding Light=#F5F0FF, Dark=#0D0D0D}" Offset="0.1" />
            <GradientStop Color="{AppThemeBinding Light=#EDE0FF, Dark=#1A0B2E}" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <Grid RowDefinitions="Auto, *">

            <Grid Grid.Row="0" Padding="15,15,15,0" HorizontalOptions="Fill">
                <ImageButton Clicked="OnHamburgerClicked"
                             HeightRequest="40"
                             WidthRequest="40"
                             HorizontalOptions="Start"
                             BackgroundColor="Transparent"
                             ToolTipProperties.Text="Menu">
                    <ImageButton.Source>
                        <FontImageSource Glyph="&#xf0c9;" 
                                         FontFamily="FontAwesomeSolid" 
                                         Color="DarkViolet" 
                                         Size="24"/>
                    </ImageButton.Source>
                </ImageButton>
                <ImageButton Command="{Binding ToggleThemeCommand}"
                             HeightRequest="40"
                             WidthRequest="40"
                             HorizontalOptions="End"
                             BackgroundColor="Transparent">
                    <ImageButton.Source>
                        <FontImageSource Glyph="{Binding ThemeIcon}" 
                                         FontFamily="FontAwesomeSolid" 
                                         Color="DarkViolet" 
                                         Size="24"/>
                    </ImageButton.Source>
                </ImageButton>


            </Grid>

            <Grid Grid.Row="1">

                <ScrollView IsVisible="{Binding IsInputVisible}">
                    <VerticalStackLayout Padding="25" Spacing="25" HorizontalOptions="Fill" MaximumWidthRequest="500">
                        <Label Text="AI analiza wideo"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="DarkViolet"
                               HorizontalOptions="Center"
                               Margin="0,30,0,10"/>



                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" Padding="15">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Link do filmu z Youtube:" 
                                       TextColor="DarkViolet" 
                                       FontSize="20"
                                       FontAttributes="Bold"/>
                                <Entry Placeholder="https://www.youtube.com/..."
                                       Text="{Binding VideoUrl}"
                                       TextColor="{AppThemeBinding Light=#1A0B2E, Dark=White}"
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}"
                                       ClearButtonVisibility="WhileEditing" />
                            </VerticalStackLayout>
                        </Border>

                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}"  Padding="20">
                            <VerticalStackLayout Spacing="15">
                                <Label Text="Opcje analizy:" 
                                       TextColor="DarkViolet" 
                                       FontSize="20" 
                                       FontAttributes="Bold" 
                                       Margin="0,0,0,5"/>
                                <HorizontalStackLayout Spacing="15">
                                    <CheckBox IsChecked="{Binding ChceStreszczenie}" Color="DarkViolet" />
                                    <Label Text="Skrócony opis" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#1A0B2E, Dark=White}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="15">
                                    <CheckBox IsChecked="{Binding ChceWniosek}" Color="DarkViolet" />
                                    <Label Text="Kluczowe wnioski" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#1A0B2E, Dark=White}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="15">
                                    <CheckBox IsChecked="{Binding ChceTimestamps}" Color="DarkViolet" />
                                    <Label Text="Ważne punkty (Timestamps)" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#1A0B2E, Dark=White}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        
                        

                        <Button Text="Przetwarzaj wideo" 
                                Command="{Binding ProcessVideoCommand}"
                                BackgroundColor="DarkViolet"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="60"
                                WidthRequest="200"
                                HorizontalOptions="Center">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="DarkViolet"/>
                                                <Setter Property="Opacity" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="Gray"/>
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                        </Button>
                    </VerticalStackLayout>
                </ScrollView>

                <VerticalStackLayout IsVisible="{Binding IsLoading}" VerticalOptions="Center" HorizontalOptions="Fill" Spacing="30" MaximumWidthRequest="500">
                    <ActivityIndicator IsRunning="{Binding IsLoading}" Color="DarkViolet" HeightRequest="120" WidthRequest="120"></ActivityIndicator>
                    <Label Text="Trwa analiza materiału..." 
                           TextColor="{AppThemeBinding Light=#1A0B2E, Dark=White}" 
                           FontSize="22" 
                           HorizontalOptions="Center" 
                           FontAttributes="Bold">
                    </Label>
                    <Label Text="Gemini przetwarza dane, proszę czekać." 
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark=Gray}" 
                           HorizontalOptions="Center">
                    </Label>
                </VerticalStackLayout>

                <ScrollView IsVisible="{Binding IsResultVisible}">
                    <VerticalStackLayout Padding="25" Spacing="20" HorizontalOptions="Fill" MaximumWidthRequest="500">
                        
                        <VerticalStackLayout IsVisible="{Binding IsVideoInfoVisible}" Spacing="10">
                            <Border StrokeShape="RoundRectangle 8"
                                        StrokeThickness="0"
                                        HorizontalOptions="Center"
                                        WidthRequest="300">
                                <Image Source="{Binding VideoThumbnailUrl}" 
                                       Aspect="AspectFill"
                                       HeightRequest="170"
                                       WidthRequest="300"/>
                            </Border>
                            <Label Text="{Binding VideoTitle}" 
                                   HorizontalTextAlignment="Center"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}"
                                   WidthRequest="400"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>

                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E0D0F0, Dark={StaticResource Gray900}}"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}">
                            <VerticalStackLayout>
                                <Grid BackgroundColor="{AppThemeBinding Light=#E8D5FF, Dark={StaticResource Gray950}}" Padding="10,5">
                                    <Label Text="Wynik analizy:" 
                                           TextColor="DarkViolet" 
                                           FontSize="20" 
                                           VerticalOptions="Center" 
                                           Margin="5" 
                                           FontAttributes="Bold"/>
                                    <HorizontalStackLayout HorizontalOptions="End" VerticalOptions="Center" Spacing="5">
                                        <ImageButton Command="{Binding SaveToFileCommand}"
                                                     HeightRequest="32" WidthRequest="32" Padding="6" CornerRadius="6" BackgroundColor="Transparent" Opacity="0.7">
                                            <ImageButton.Source>
                                                <FontImageSource Glyph="&#xf019;" FontFamily="FontAwesomeSolid" Color="DarkViolet" Size="18"/>
                                            </ImageButton.Source>
                                        </ImageButton>

                                        <ImageButton Command="{Binding CopyToClipboardCommand}"
                                                     HeightRequest="32" WidthRequest="32" Padding="6" CornerRadius="6" BackgroundColor="Transparent" Opacity="0.7">
                                            <ImageButton.Source>
                                                <FontImageSource Glyph="&#xf0c5;" FontFamily="FontAwesomeSolid" Color="DarkViolet" Size="18"/>
                                            </ImageButton.Source>
                                        </ImageButton>
                                    </HorizontalStackLayout>
                                </Grid>
                                <ScrollView HeightRequest="350" Padding="15">
                                    <Label Text="{Binding TekstWynikowy}"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"
                                           LineHeight="1.4"
                                           FontSize="15"
                                           HorizontalOptions="Fill">
                                    </Label>
                                </ScrollView>
                            </VerticalStackLayout>
                        </Border>
                        
                        <Button Text="Wróć do konfiguracji" 
                                Command="{Binding BackToInputCommand}" 
                                BackgroundColor="DarkViolet" 
                                TextColor="White" 
                                CornerRadius="12" 
                                HeightRequest="50" 
                                Margin="0,20">
                        </Button>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Grid>

        <BoxView x:Name="MenuOverlay" 
                 BackgroundColor="Black" 
                 Opacity="0" 
                 IsVisible="False"
                 InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOverlayTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Grid x:Name="SidebarMenu" 
              BackgroundColor="{AppThemeBinding Light=#F5F0FF, Dark={StaticResource Gray950}}"  
              WidthRequest="300" 
              HorizontalOptions="Start" 
              TranslationX="-300">

            <Border StrokeShape="RoundRectangle 0,15,15,0" 
                    StrokeThickness="1" 
                    Stroke="{AppThemeBinding Light=#E0D0F0, Dark={StaticResource Gray900}}"
                    BackgroundColor="{AppThemeBinding Light=#F5F0FF, Dark={StaticResource Gray950}}">

                <VerticalStackLayout Padding="20" Spacing="25">

                    <ImageButton Clicked="OnOverlayTapped"
                                 HeightRequest="40"
                                 WidthRequest="40"
                                 HorizontalOptions="Start"
                                 BackgroundColor="Transparent"
                                 Margin="220,-5,0,0">
                        <ImageButton.Source>
                            <FontImageSource Glyph="&#xf060;" 
                                             FontFamily="FontAwesomeSolid" 
                                             Color="DarkViolet" 
                                             Size="24"/>
                        </ImageButton.Source>
                    </ImageButton>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0D0F0, Dark={StaticResource Gray900}}" />

                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark={StaticResource Gray900}}" Padding="15">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Klucz API Gemini:" 
                                   TextColor="DarkViolet" 
                                   FontSize="20" 
                                   FontAttributes="Bold"/>
                            <Entry Placeholder="Wklej swój klucz api AI studio..."
                                   Text="{Binding UserApiKey}"
                                   TextColor="{AppThemeBinding Light=#1A0B2E, Dark=White}"
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                            <Label Text="Klucz jest zapisywany lokalnie w urządzeniu."
                                   FontSize="10" 
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark=Gray}" 
                                   HorizontalOptions="End"/>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>