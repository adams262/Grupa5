<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PZPP_Grupa5.Views.MainPage"
             xmlns:viewmodels="clr-namespace:PZPP_Grupa5.ViewModels"
             x:DataType="viewmodels:MainViewModel"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style TargetType="Button">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="0.95" />
                                <Setter Property="Opacity" Value="0.8" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{AppThemeBinding Light=#F5F0FF, Dark=#0D0D0D}" Offset="0.1" />
            <GradientStop Color="{AppThemeBinding Light=#EDE0FF, Dark=#1A0B2E}" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <Grid RowDefinitions="Auto, *">
            <Grid Grid.Row="0" Padding="15,15,15,0" HorizontalOptions="Fill">
                <ImageButton Clicked="OnHamburgerClicked"
                             HeightRequest="40"
                             WidthRequest="40"
                             HorizontalOptions="Start"
                             BackgroundColor="Transparent"
                             ToolTipProperties.Text="Menu">
                    <ImageButton.Source>
                        <FontImageSource Glyph="&#xf0c9;" 
                                         FontFamily="FontAwesomeSolid" 
                                         Color="DarkViolet" 
                                         Size="24"/>
                    </ImageButton.Source>
                </ImageButton>
                <ImageButton Command="{Binding ToggleThemeCommand}"
                             HeightRequest="40"
                             WidthRequest="40"
                             HorizontalOptions="End"
                             BackgroundColor="Transparent">
                    <ImageButton.Source>
                        <FontImageSource Glyph="{Binding ThemeIcon}" 
                                         FontFamily="FontAwesomeSolid" 
                                         Color="DarkViolet" 
                                         Size="24"/>
                    </ImageButton.Source>
                </ImageButton>


            </Grid>

            <Grid Grid.Row="1">
                <ScrollView x:Name="InputView" IsVisible="{Binding IsInputVisible} " ZIndex="0">
                    <VerticalStackLayout Padding="25" Spacing="25" HorizontalOptions="Fill" MaximumWidthRequest="500">
                        <Label Text="AI-NALISER" FontSize="32" FontAttributes="Bold" TextColor="#FF0000" HorizontalOptions="Center" Margin="0,30,0,10"/>

                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" Padding="15">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Link do filmu z Youtube:" 
                                       TextColor="DarkViolet" 
                                       FontSize="20"
                                       FontAttributes="Bold"/>
                                <Entry Placeholder="https://www.youtube.com/..."
                                       Text="{Binding VideoUrl}"
                                       TextColor="{AppThemeBinding Light=#1A0B2E, Dark=White}"
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}"
                                       ClearButtonVisibility="WhileEditing" />
                            </VerticalStackLayout>
                        </Border>

                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}"  Padding="20">
                            <VerticalStackLayout Spacing="15">
                                <Label Text="OPTIONS" TextColor="#FF0000" FontSize="20" FontAttributes="Bold" Margin="0,0,0,5"/>
                                <HorizontalStackLayout Spacing="15">
                                    <CheckBox IsChecked="{Binding ChceStreszczenie}" Color="DarkViolet" />
                                    <Label Text="Skrócony opis" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#1A0B2E, Dark=White}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="15">
                                    <CheckBox IsChecked="{Binding ChceWniosek}" Color="DarkViolet" />
                                    <Label Text="Kluczowe wnioski" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#1A0B2E, Dark=White}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="15">
                                    <CheckBox IsChecked="{Binding ChceTimestamps}" Color="DarkViolet" />
                                    <Label Text="Ważne punkty (Timestamps)" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#1A0B2E, Dark=White}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        
                        

                        <Button Text="PROCESS VIDEO" Command="{Binding ProcessVideoCommand}" Pressed="OnElementPressed" Released="OnElementReleased" BackgroundColor="#FF0000" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="60" WidthRequest="200" HorizontalOptions="Center">
                            <Button.GestureRecognizers>
                                <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                            </Button.GestureRecognizers>
                        </Button>
                    </VerticalStackLayout>
                </ScrollView>

                <VerticalStackLayout IsVisible="{Binding IsLoading}" VerticalOptions="Center" HorizontalOptions="Fill" Spacing="30" MaximumWidthRequest="500">
                    <ActivityIndicator IsRunning="{Binding IsLoading}" Color="DarkViolet" HeightRequest="120" WidthRequest="120"></ActivityIndicator>
                    <Label Text="Trwa analiza materiału..." 
                           TextColor="{AppThemeBinding Light=#1A0B2E, Dark=White}" 
                           FontSize="22" 
                           HorizontalOptions="Center" 
                           FontAttributes="Bold">
                    </Label>
                    <Label Text="Gemini przetwarza dane, proszę czekać." 
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark=Gray}" 
                           HorizontalOptions="Center">
                    </Label>
                </VerticalStackLayout>

                <ScrollView x:Name="ResultView" IsVisible="{Binding IsResultVisible}" ZIndex="1">
                    <VerticalStackLayout Padding="25" Spacing="20" HorizontalOptions="Fill" MaximumWidthRequest="500">

                        <VerticalStackLayout IsVisible="{Binding IsVideoInfoVisible}" Spacing="2
                                             " HorizontalOptions="Fill">

                            <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" HeightRequest="250" HorizontalOptions="Fill">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OdtworzWideoCommand}" />
                                    <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                                </Border.GestureRecognizers>
                                <Image Source="{Binding VideoThumbnailUrl}" Aspect="AspectFill" />
                            </Border>

                            <Border BackgroundColor="Transparent" StrokeThickness="0" Padding="0,5">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OtworzLinkWideoCommand}" />
                                    <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding VideoTitle}" 
       HorizontalTextAlignment="Center" 
       FontAttributes="Bold" 
       FontSize="16" 
       HorizontalOptions="Fill"
       TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                            </Border>
                            <Label Text="{Binding VideoTitle}" 
                                   HorizontalTextAlignment="Center"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}"
                                   WidthRequest="400"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>

                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E0D0F0, Dark={StaticResource Gray900}}"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}">
                            <VerticalStackLayout>
                                <Grid BackgroundColor="{AppThemeBinding Light=#E8D5FF, Dark={StaticResource Gray950}}" Padding="10,5">
                                    <Label Text="Wynik analizy:" 
                                           TextColor="DarkViolet" 
                                           FontSize="20" 
                                           VerticalOptions="Center" 
                                           Margin="5" 
                                           FontAttributes="Bold"/>
                                    <HorizontalStackLayout HorizontalOptions="End" VerticalOptions="Center" Spacing="5">
                                        <ImageButton Command="{Binding SaveToFileCommand}"
                                                     HeightRequest="32" WidthRequest="32" Padding="6" CornerRadius="6" BackgroundColor="Transparent" Opacity="0.7">
                                            <ImageButton.Source>
                                                <FontImageSource Glyph="&#xf019;" FontFamily="FontAwesomeSolid" Color="DarkViolet" Size="18"/>
                                            </ImageButton.Source>
                                        </ImageButton>

                                    <HorizontalStackLayout HorizontalOptions="End" Spacing="10" VerticalOptions="Center">
                                        <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#333333}" WidthRequest="36" HeightRequest="36" Padding="0">
                                            <Border.Shadow>
                                                <Shadow Brush="Black" Offset="2,2" Radius="5" Opacity="0.3" />
                                            </Border.Shadow>
                                            <Border.GestureRecognizers>
                                                <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                                            </Border.GestureRecognizers>
                                            <Button Command="{Binding SaveToFileCommand}" Pressed="OnElementPressed" Released="OnElementReleased" Text="&#xf019;" FontFamily="Font Awesome 7 Free" TextColor="#FF0000" FontSize="16" BackgroundColor="Transparent" BorderWidth="0" Padding="0" Margin="0" />
                                        </Border>

                                        <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#333333}" WidthRequest="36" HeightRequest="36" Padding="0">
                                            <Border.Shadow>
                                                <Shadow Brush="Black" Offset="2,2" Radius="5" Opacity="0.3" />
                                            </Border.Shadow>
                                            <Border.GestureRecognizers>
                                                <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                                            </Border.GestureRecognizers>
                                            <Button Command="{Binding CopyToClipboardCommand}" Pressed="OnElementPressed" Released="OnElementReleased" Text="&#xf0c5;" FontFamily="Font Awesome 7 Free" TextColor="#FF0000" FontSize="16" BackgroundColor="Transparent" BorderWidth="0" Padding="0" Margin="0" />
                                        </Border>
                                    </HorizontalStackLayout>
                                </Grid>
                                <ScrollView HeightRequest="350" Padding="15">
                                    <Label Text="{Binding TekstWynikowy}"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"
                                           LineHeight="1.4"
                                           FontSize="15"
                                           HorizontalOptions="Fill">
                                    </Label>
                                </ScrollView>
                            </VerticalStackLayout>
                        </Border>

                        <Button Text="BACK TO INPUT" Clicked="OnBackButtonClicked" Pressed="OnElementPressed" Released="OnElementReleased" BackgroundColor="#FF0000" TextColor="White" CornerRadius="12" HeightRequest="50">
                            <Button.GestureRecognizers>
                                <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                            </Button.GestureRecognizers>
                        </Button>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Grid>

        <BoxView x:Name="MenuOverlay" BackgroundColor="Black" Opacity="0" IsVisible="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOverlayTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Grid x:Name="SidebarMenu" 
              BackgroundColor="{AppThemeBinding Light=#F5F0FF, Dark={StaticResource Gray950}}"  
              WidthRequest="300" 
              HorizontalOptions="Start" 
              TranslationX="-300">

            <Border StrokeShape="RoundRectangle 0,15,15,0" 
                    StrokeThickness="1" 
                    Stroke="{AppThemeBinding Light=#E0D0F0, Dark={StaticResource Gray900}}"
                    BackgroundColor="{AppThemeBinding Light=#F5F0FF, Dark={StaticResource Gray950}}">

                    <Border Grid.Row="2" StrokeShape="RoundRectangle 12" StrokeThickness="2" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}" Padding="15" Margin="5,0,5,25">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="4,4" Radius="10" Opacity="0.3" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                        </Border.GestureRecognizers>
                        <Border.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{AppThemeBinding Light=#E0D0F0, Dark=#151515}" Offset="0.0" />
                                <GradientStop Color="{AppThemeBinding Light=#E0D0F0, Dark=#FF0000}" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Stroke>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="GEMINI API" TextColor="#FF0000" FontAttributes="Bold"/>
                            <Entry Text="{Binding UserApiKey}" TextColor="{AppThemeBinding Light=#1A0B2E, Dark=White}" PlaceholderColor="Gray" Placeholder="Wklej klucz..." />
                        </VerticalStackLayout>
                    </Border>

                    <Label Grid.Row="3" Text="CHAT HISTORY" TextColor="#FF0000" FontSize="20" FontAttributes="Bold" Margin="5,0,0,5"/>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0D0F0, Dark={StaticResource Gray900}}" />

                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark={StaticResource Gray900}}" Padding="15">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Klucz API Gemini:" 
                                   TextColor="DarkViolet" 
                                   FontSize="20" 
                                   FontAttributes="Bold"/>
                            <Entry Placeholder="Wklej swój klucz api AI studio..."
                                   Text="{Binding UserApiKey}"
                                   TextColor="{AppThemeBinding Light=#1A0B2E, Dark=White}"
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                            <Label Text="Klucz jest zapisywany lokalnie w urządzeniu."
                                   FontSize="10" 
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark=Gray}" 
                                   HorizontalOptions="End"/>
                        </VerticalStackLayout>
                    </Border>

                                        <Grid ColumnDefinitions="*, Auto">

                                            <VerticalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center" BackgroundColor="Transparent">
                                                <VerticalStackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnHistoryItemTapped" />
                                                </VerticalStackLayout.GestureRecognizers>
                                                <Label Text="{Binding TytulWideo}" TextColor="{AppThemeBinding Light=Black, Dark=White}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding DataUtworzenia, StringFormat='{0:dd.MM.yyyy HH:mm}'}" FontSize="12" TextColor="Gray" />
                                            </VerticalStackLayout>

                                            <Button Grid.Column="1" 
        Clicked="OnDeleteHistoryItemClicked"
        Pressed="OnElementPressed"
        Released="OnElementReleased"
        Text="&#xf1f8;" 
        FontFamily="Font Awesome 7 Free" 
        TextColor="#FF0000" 
        FontSize="18" 
        BackgroundColor="Transparent" 
        BorderWidth="0" 
        VerticalOptions="Center">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroupList>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal">
                                                                <VisualState.Setters>
                                                                    <Setter Property="Opacity" Value="0.2" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                            <VisualState x:Name="PointerOver">
                                                                <VisualState.Setters>
                                                                    <Setter Property="Opacity" Value="1.0" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateGroupList>
                                                </VisualStateManager.VisualStateGroups>
                                            </Button>

                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>